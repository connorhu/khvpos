{
    "name": "connorhu/khvpos",
    "description": "Helper tools for working with K&H src/VPos",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "ext-bcmath": "*",
        "ext-openssl": "*",
        "symfony/validator": "^6.4 || ^7.2",
        "symfony/serializer": "^6.4 || ^7.2",
        "symfony/property-access": "^6.4 || ^7.2"
    },
    "require-dev": {
        "symfony/http-client": "^6.4 || ^7.2",
        "symfony/var-dumper": "^6.4 || ^7.2",
        "nyholm/psr7": "^1.8",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "phpstan/phpstan": "^2.0",
        "symfony/dotenv": "^7.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "nyholm/symfony-bundle-test": "^1.4",
        "symfony/framework-bundle": "^6.4 || ^7.4"
    },
    "suggest": {
        "symfony/http-kernel": "Required for Symfony bundle integration (^6.4 || ^7.4)",
        "symfony/config": "Required for Symfony bundle integration (^6.4 || ^7.4)",
        "symfony/dependency-injection": "Required for Symfony bundle integration (^6.4 || ^7.4)",
        "symfony/http-client": "Required PSR-18 HTTP client implementation (^6.4 || ^7.4)",
        "nyholm/psr7": "Required PSR-7 implementation (^1.8)"
    },
    "autoload": {
        "psr-4": {
            "KHTools\\VPos\\": "src/",
            "KHTools\\VPos\\Bundle\\": "src/Bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KHTools\\Tests\\": "tests/Tests/"
        }
    },
    "scripts": {
        "test": "phpunit-11 --colors=always",
        "coverage": "XDEBUG_MODE=coverage phpunit-11 --colors=always --coverage-html=tests/coverage",
        "coverage:clover": "XDEBUG_MODE=coverage phpunit-11 --colors=always --coverage-clover=coverage.xml",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpstan-tests": "phpstan analyse --memory-limit=1G -c phpstan-tests.neon.dist",
        "analyze": [
            "@phpstan",
            "@phpstan-tests"
        ],
        "pre-commit": [
            "@test",
            "@analyze"
        ]
    }
}
